{
  "info": {
    "name": "Checkpoint 06 - Produtos",
    "description": "Backend de cadastro de produtos com autenticação JWT. Ordem: Criar usuário -> Login -> rotas de produtos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação (público)",
      "item": [
        {
          "name": "Criar usuário",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "201 Created (409 se o email já existir).",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"exemplo@email.com\", \"password\": \"123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "200 OK com o token JWT. O script salva o token em {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"exemplo@email.com\", \"password\": \"123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Produtos (exige token)",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "description": "200 OK (401 sem token)."
          }
        },
        {
          "name": "Cadastrar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            },
            "description": "201 Created. Copie o id da resposta para a variável {{id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Notebook Dell\", \"preco\": 4500.0, \"quantidadeEstoque\": 10, \"ativo\": \"Y\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{id}}"
              ]
            },
            "description": "200 OK ou 404."
          }
        },
        {
          "name": "Alterar (PUT)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{id}}"
              ]
            },
            "description": "Substitui todos os campos. 200 OK ou 404.",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Notebook Dell i7\", \"preco\": 5200.0, \"quantidadeEstoque\": 8, \"ativo\": \"Y\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ativar/Desativar (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{id}}"
              ]
            },
            "description": "Altera apenas o campo ativo. 200 OK ou 404.",
            "body": {
              "mode": "raw",
              "raw": "{\"ativo\": \"N\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{id}}"
              ]
            },
            "description": "204 No Content ou 404."
          }
        }
      ]
    }
  ]
}